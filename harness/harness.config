# Which AI harness drives routing + agent execution.
# This is the ONE line you change to swap the engine (plug & play).
# An adapter named "<HARNESS>.sh" must exist in this folder and implement:
#   harness_name        -> human-readable name
#   harness_check        -> exit 0 if the harness CLI + AI credentials are ready
#   harness_route        -> given a goal + actions catalog JSON, print the best action id
#   harness_run_agent    -> given an agent name, goal, and interactive flag, run it
#
# Built-in adapters: claude-code
# To integrate an open-source / other agent: copy _template.sh to <name>.sh,
# implement the four functions, and set HARNESS=<name> below.
HARNESS=claude-code

# Optional: override the credentials env var the setup checks for (per harness).
# For claude-code this is ANTHROPIC_API_KEY (or an interactive `claude` login).
AI_CREDENTIAL_ENV=ANTHROPIC_API_KEY
