# Allowed Bash prefixes for the label rules curator
gws gmail users labels list
gws gmail users labels create
gws gmail users labels patch
gws gmail users messages list
gws gmail +triage
gws schema
bash scripts/discover-senders.sh
bash scripts/nightly-label.sh

# Pipelines into these read-only filters are also permitted by bash-guard
# (safe read-only filters, enforced in bash-guard.py SAFE_FILTERS):
#   jq grep head tail cut sort uniq wc tr cat rev nl column
# e.g.  gws gmail users labels list --params '{"userId":"me"}' | jq '.labels[].name'
